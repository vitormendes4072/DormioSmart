# Copie este arquivo para .env e preencha com os valores reais.
# O .env real NUNCA é versionado (está no .gitignore). Este .example SIM.

# Supabase — projeto: Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# O backend (Flask) é server-side e usa a chave service_role (full-access),
# mantendo o RLS ligado no banco. NUNCA commitar, logar ou expor esta chave:
# ela vive apenas no .env local (ignorado) e nas variáveis de ambiente do
# servidor (Vercel). Se vazar, rotacione imediatamente no Supabase.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta-aqui

# A chave anon/publicável. AGORA É OBRIGATÓRIA (AUTH-03): o backend a usa para
# validar o JWT do usuário e para montar o cliente por requisição que carrega
# esse JWT — é assim que o RLS por dono passa a valer na leitura.
# É pública por design; o isolamento vem do RLS, não do sigilo dela.
# Mesmo valor que o frontend usa em VITE_SUPABASE_ANON_KEY.
SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# Flask
FLASK_ENV=development
