{
  "version": 2,
  "builds": [
    {
      "src": "web-app/app.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "web-app/app.py" },
    { "src": "/health", "dest": "web-app/app.py" },

    { "handle": "filesystem" },

    { "src": "/assets/(.*)", "dest": "/frontend/assets/$1" },
    { "src": "/(.*\.[a-zA-Z0-9]+)", "dest": "/frontend/$1" },
    { "src": "/(.*)", "dest": "/frontend/index.html" }
  ]
}
