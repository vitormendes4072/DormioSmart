# DADO NUNCA ENTRA NO GIT.
# O bruto é grande (Newcastle = 962,8 MB) e, no caso das bases com DUA, a
# redistribuição é proibida pelo próprio acordo assinado.
dados/bruto/*
dados/processado/*
!dados/bruto/.gitkeep
!dados/processado/.gitkeep

# Saídas de experimento: o log de métricas (.json) É versionado de propósito,
# porque é o registro do resultado. O resto, não.
experimentos/saida/*
!experimentos/saida/.gitkeep
!experimentos/saida/*.json

# ML-15: nova rodada separada dos históricos que a auditoria ML-14 fixa.
!experimentos/saida/ml15/
experimentos/saida/ml15/*
!experimentos/saida/ml15/*.json
!experimentos/saida/ml15/resultados/
experimentos/saida/ml15/resultados/*
!experimentos/saida/ml15/resultados/*.json

# Checkpoints por dobra do LOSO retomável (experimentos/_retomada.py). São
# estado intermediário de execução, não resultado: o resultado vai para o
# .json. Já cairiam na regra acima; explícito porque a pasta é nova.
experimentos/saida/_parciais/

__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# ML-16: evidências da reconstrução dos registros históricos.
!experimentos/saida/ml16/
experimentos/saida/ml16/*
!experimentos/saida/ml16/*.json
!experimentos/saida/ml16/resultados/
experimentos/saida/ml16/resultados/*
!experimentos/saida/ml16/resultados/*.json
